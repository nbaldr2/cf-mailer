# Cloudflare Email Service Configuration
CLOUDFLARE_ACCOUNT_ID="your_account_id_here"
CLOUDFLARE_API_TOKEN="your_api_token_here"
CLOUDFLARE_FROM_EMAIL="noreply@yourdomain.com"
CLOUDFLARE_FROM_NAME="Your App Name"

# Mailer Settings
MAILER_TIMEOUT=30
MAILER_RETRY_ATTEMPTS=3
MAILER_RETRY_DELAY=1000
MAILER_LOG_LEVEL="debug"
MAILER_LOG_PATH="./logs/mailer.log"

# Rate Limiting
MAILER_RATE_LIMIT_PER_SECOND=10
MAILER_RATE_LIMIT_PER_MINUTE=100

# Queue Settings (optional, for queue-ready architecture)
MAILER_QUEUE_ENABLED=false
MAILER_QUEUE_DRIVER="database"
MAILER_QUEUE_TABLE="email_queue"
