{
    "name": "soufiane/cf-mailer",
    "description": "Production-ready Cloudflare Email Service API mailer for PHP 8.2+",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7",
        "egulias/email-validator": "^4.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "CfMailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CfMailer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "lint": "phpcs --standard=PSR12 src/",
        "analyse": "phpstan analyse src/ --level=max"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
